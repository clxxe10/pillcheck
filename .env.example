# Copy to .env.local and fill in. These are read on the server only — never prefix with NEXT_PUBLIC_.

# "gemini" (default) or "claude"
AI_PROVIDER=gemini

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash
GEMINI_MODEL=

# Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=

# Optional. Public data portal key for MFDS DUR combination checks.
# Without it, /api/safety uses the local rules in src/lib/safety/interactions.json.
DATA_GO_KR_KEY=

# Optional. Shared cap on live /api/extract calls per UTC day. Default 200.
DAILY_EXTRACT_LIMIT=
